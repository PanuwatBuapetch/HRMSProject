@page "/login"

@inject AuthState State
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ModalService ModalService

@using AntDesign
@using System.Net.Http.Json
@using Hrms_project.Models

<div style="display: flex; justify-content: center; align-items: center; height: 100vh; background: #f0f2f5; flex-direction: column;">

    <Card Style="width: 350px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
        <h3 style="text-align: center; margin-bottom: 30px;">HRMS LOGIN</h3>

        <Form Model="@loginModel"
              Layout="@FormLayout.Vertical"
              OnFinish="OnLogin">

            <FormItem Label="Username">
                <Input @bind-Value="@loginModel.Username"
                       Placeholder="กรอกชื่อผู้ใช้" />
            </FormItem>

            <FormItem Label="Password">
                <InputPassword @bind-Value="@loginModel.Password"
                               Placeholder="กรอกรหัสผ่าน" />
            </FormItem>

            <Button Type="@ButtonType.Primary"
                    HtmlType="submit"
                    Block>
                เข้าสู่ระบบ
            </Button>

        </Form>
    </Card>
</div>

@code {
    private LoginRequest loginModel = new();

    protected override void OnInitialized()
    {
        // บังคับดีดกลับไปหน้าแรกถ้า Login อยู่แล้ว
        if (State.IsLoggedIn)
        {
            Nav.NavigateTo("/");
        }
    }

    public class LoginRequest
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string EmployeeId { get; set; } = "";
        public string FullNameThai { get; set; } = "";
        public string Username { get; set; } = "";
        public string Role { get; set; } = "";
    }

    private async Task OnLogin()
    {
        try
        {
            // MOCK SUPER ADMIN
            if (loginModel.Username == "superadmin"
                && loginModel.Password == "super123")
            {
                State.Login("SuperAdmin");

                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "true");
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userRole", "SuperAdmin");
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "fullName", "SUPER ADMIN");

                Nav.NavigateTo("/", true);
                return;
            }

            var client = HttpClientFactory.CreateClient("Api");

            var response = await client.PostAsJsonAsync("api/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if (result != null)
                {
                    State.Login(result.Role);

                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "isLoggedIn", "true");
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userRole", result.Role);
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "employeeId", result.EmployeeId);
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "fullName", result.FullNameThai);

                    Nav.NavigateTo("/", true);
                }
            }
            else
            {
                ModalService.Error(new ConfirmOptions()
                {
                    Title = "เข้าสู่ระบบไม่สำเร็จ",
                    Content = "ชื่อผู้ใช้งานหรือรหัสผ่านไม่ถูกต้อง"
                });
            }
        }
        catch (Exception ex)
        {
            ModalService.Error(new ConfirmOptions()
            {
                Title = "เกิดข้อผิดพลาด",
                Content = ex.Message
            });
        }
    }
}